# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required on the server (Vercel Environment Variables or AI Studio Secrets) to send contact form emails via Resend.
RESEND_API_KEY=""

# CONTACT_RECIPIENT_EMAIL: Studio inbox that receives contact form inquiries (defaults to zaheerhasiphone@gmail.com).
CONTACT_RECIPIENT_EMAIL="zaheerhasiphone@gmail.com"

# RESEND_FROM_EMAIL: Verified sender address in Resend (defaults to "Orpheus Studios <onboarding@resend.dev>" until domain verification).
RESEND_FROM_EMAIL="Orpheus Studios <onboarding@resend.dev>"

# VITE_CONTACT_ENDPOINT: Optional override for contact API route (defaults to "/api/contact").
VITE_CONTACT_ENDPOINT="/api/contact"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript API key (injected by AI Studio or Vercel Env Vars).
VITE_GOOGLE_MAPS_API_KEY=""

